{
    "name": "masilia/editorial-toolbox",
    "description": "In-context editorial toolbox for Ibexa: front-end edit toolbar, block sidebar and the JSON API behind them",
    "keywords": [
        "ibexa",
        "ibexa-dxp",
        "ibexa-4.6",
        "ibexa-5",
        "symfony-bundle",
        "in-context-editing",
        "toolbar",
        "cms"
    ],
    "homepage": "https://github.com/MasiliaLabs/ibexa-editorial-toolbox",
    "license": "MIT",
    "authors": [
        {
            "name": "MasiliaLabs",
            "homepage": "https://github.com/MasiliaLabs"
        }
    ],
    "support": {
        "issues": "https://github.com/MasiliaLabs/ibexa-editorial-toolbox/issues",
        "source": "https://github.com/MasiliaLabs/ibexa-editorial-toolbox",
        "security": "https://github.com/MasiliaLabs/ibexa-editorial-toolbox/security/policy"
    },
    "type": "symfony-bundle",
    "require": {
        "php": "^8.1",
        "ibexa/admin-ui": "^4.6 || ^5.0",
        "ibexa/core": "^4.6 || ^5.0",
        "symfony/config": "^5.4 || ^6.4 || ^7.0",
        "symfony/dependency-injection": "^5.4 || ^6.4 || ^7.0",
        "symfony/event-dispatcher": "^5.4 || ^6.4 || ^7.0",
        "symfony/framework-bundle": "^5.4 || ^6.4 || ^7.0",
        "symfony/http-foundation": "^5.4 || ^6.4 || ^7.0",
        "symfony/http-kernel": "^5.4 || ^6.4 || ^7.0",
        "symfony/routing": "^5.4 || ^6.4 || ^7.0",
        "symfony/security-csrf": "^5.4 || ^6.4 || ^7.0",
        "symfony/translation-contracts": "^2.5 || ^3.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0",
        "phpstan/phpstan": "^1.10 || ^2.0"
    },
    "autoload": {
        "psr-4": {
            "Masilia\\EditorialToolbox\\": "src/lib/",
            "Masilia\\Bundle\\EditorialToolbox\\": "src/bundle/",
            "Masilia\\Contracts\\EditorialToolbox\\": "src/contracts/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Masilia\\Tests\\EditorialToolbox\\": "tests/lib/",
            "Masilia\\Tests\\Bundle\\EditorialToolbox\\": "tests/bundle/"
        }
    },
    "scripts": {
        "test": [
            "@phpunit"
        ],
        "phpunit": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.3.x-dev"
        }
    },
    "suggest": {
        "masilia/ibexa-blocks": "Marks the page and its blocks for in-context editing",
        "masilia/ibexa-sites": "Sets the admin siteaccess of each site from its registry (masilia_editorial_toolbox.admin_siteaccess)"
    }
}
